# SSN Import Configuration Example
# Copy this file and modify according to your environment

# ClickHouse Server Configuration
CLICKHOUSE_HOST=localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=ssn_records

# File Configuration
# Pattern for SSN files (supports glob patterns)
SSN_FILE_PATTERN=/mnt/e/ssn/ssn_out_*.txt
# Expected number of files (for validation)
EXPECTED_FILE_COUNT=188

# Import Settings
# Number of retry attempts for failed imports
RETRY_COUNT=3
# Delay between file imports (seconds)
DELAY_BETWEEN_FILES=0.3

# Notes:
# 1. Adjust SSN_FILE_PATTERN to match your file location
# 2. Set EXPECTED_FILE_COUNT to 0 to skip file count validation
# 3. Increase RETRY_COUNT if experiencing intermittent connection issues
# 4. Adjust DELAY_BETWEEN_FILES to control import rate
